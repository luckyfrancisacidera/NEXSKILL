# NEXSKILL staging/production environment template
# REQUIRED: must be set before the stack can boot correctly
# OPTIONAL: only set when you use that integration
# DEV-ONLY: local development convenience; keep disabled in staging/production

# Ports
WEB_PORT=8088
API_PORT=5062
POSTGRES_PORT=5432

# ASP.NET runtime
# REQUIRED
ASPNETCORE_ENVIRONMENT=Production

# Logging
# OPTIONAL: override only if you need more or less verbosity in staging/production
LOGGING__LOGLEVEL__DEFAULT=Information
LOGGING__LOGLEVEL__MICROSOFT=Warning
LOGGING__LOGLEVEL__MICROSOFT__ASPNETCORE=Warning
LOGGING__LOGLEVEL__MICROSOFT__HOSTING__LIFETIME=Information
LOGGING__LOGLEVEL__MICROSOFT__ENTITYFRAMEWORKCORE__DATABASE__COMMAND=Warning

# PostgreSQL
# REQUIRED
POSTGRES_DB=skillsense
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
CONNECTIONSTRINGS__POSTGRESQL=Host=db;Port=5432;Database=skillsense;Username=postgres;Password=replace-with-a-strong-database-password

# JWT
# REQUIRED
JWT__KEY=replace-with-a-long-random-secret-at-least-32-bytes
JWT__ISSUER=SkillSense
JWT__AUDIENCE=SkillSense.Client

# Public origins and generated URLs
# REQUIRED for staging/production
CLIENT_ALLOWED_ORIGINS=https://staging.example.com
PASSWORDRESET__FRONTENDBASEURL=https://staging.example.com
VITE_API_BASE_URL=

# Resume parser
# REQUIRED
RESUMEPARSER__BASEURL=http://parser:8000

# Parser container
# OPTIONAL: leave defaults to use bundled parser data and parser-v2
PARSER_DATA_DIR=/app/data
PARSER_EXPERIENCE_CSV=/app/data/experience.csv
PARSER_EDUCATION_CSV=/app/data/education.csv
PARSER_JZ_SKILLS_JSONL=/app/data/jz_skill_patterns.jsonl
PARSER_DEFAULT_VERSION=v2
# OPTIONAL: parser-specific Groq overrides; leave blank to use local parsing only
PARSER_GROQ_API_KEY=
PARSER_GROQ_MODEL=llama-3.3-70b-versatile

# Storage
# REQUIRED
STORAGE_DRIVER=local
# REQUIRED when STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT_PATH=/app/storage
# OPTIONAL
RESUME_DOWNLOAD_URL_EXPIRY_SECONDS=120

# Cloudflare R2
# OPTIONAL: required only when STORAGE_DRIVER=cloud
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# SMTP
# OPTIONAL in staging, REQUIRED in production if email delivery must be live
GMAIL_SMTP_ENABLED=false
GMAIL_SMTP_REQUIRED=false
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_EMAIL=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_SMTP_FROM_EMAIL=
GMAIL_SMTP_FROM_NAME=NEXSKILL
GMAIL_SMTP_ENABLE_SSL=true

# Groq candidate explanation service
# OPTIONAL
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.1

# Startup / migrations / seeding
# STAGING/PRODUCTION: keep seeding disabled
APPLY_MIGRATIONS_ON_STARTUP=false
ENABLE_IDENTITY_SEEDING=false
RUN_MIGRATIONS_ONLY=false

# Bootstrap accounts
# STAGING/PRODUCTION: set at least BOOTSTRAP_SUPERADMIN_* before first startup
# OPTIONAL recruiter bootstrap requires an existing company id
BOOTSTRAP_SUPERADMIN_EMAIL=bootstrap-admin@example.com
BOOTSTRAP_SUPERADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
BOOTSTRAP_SUPERADMIN_FIRST_NAME=Bootstrap
BOOTSTRAP_SUPERADMIN_LAST_NAME=Admin
BOOTSTRAP_RECRUITER_EMAIL=
BOOTSTRAP_RECRUITER_PASSWORD=
BOOTSTRAP_RECRUITER_FIRST_NAME=Bootstrap
BOOTSTRAP_RECRUITER_LAST_NAME=Recruiter
BOOTSTRAP_RECRUITER_COMPANY_ID=
