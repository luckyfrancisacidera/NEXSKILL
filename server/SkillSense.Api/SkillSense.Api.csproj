<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkillSense.Application\SkillSense.Application.csproj" />
    <ProjectReference Include="..\SkillSense.Infrastructure\SkillSense.Infrastructure.csproj" />
    <ProjectReference Include="..\SkillSense.Persistence\SkillSense.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="storage\" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeModelFiles Include="models\all-MiniLM-L6-v2\**\*" />
    <RuntimeContentFiles Include="skill_aliases.json" />
  </ItemGroup>

  <Target Name="CopyRuntimeAssetsToOutput" AfterTargets="Build">
    <Copy
      SourceFiles="@(RuntimeModelFiles)"
      DestinationFiles="@(RuntimeModelFiles->'$(OutDir)models\all-MiniLM-L6-v2\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(RuntimeContentFiles)"
      DestinationFiles="@(RuntimeContentFiles->'$(OutDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyRuntimeAssetsToPublish" AfterTargets="Publish">
    <Copy
      SourceFiles="@(RuntimeModelFiles)"
      DestinationFiles="@(RuntimeModelFiles->'$(PublishDir)models\all-MiniLM-L6-v2\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(RuntimeContentFiles)"
      DestinationFiles="@(RuntimeContentFiles->'$(PublishDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <ProjectExtensions><VisualStudio><UserProperties appsettings_1json__JsonSchema="" /></VisualStudio></ProjectExtensions>

</Project>
