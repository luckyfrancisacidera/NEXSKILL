{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=<port>;Database=<database_name>;Username=<username>;Password=<password>"
  },
  "ResumeParser": {
    "BaseUrl": "http://localhost:8000",
    "Version": "legacy"
  },
  "Sbert": {
    "ModelPath": "models/all-MiniLM-L6-v2/model.onnx",
    "VocabularyPath": "models/all-MiniLM-L6-v2/vocab.txt",
    "MaxSequenceLength": 256
  },
  "CloudflareR2": {
    "AccountId": "please_create",
    "AccessKeyId": "please_create",
    "SecretAccessKey": "please_create",
    "BucketName": "resume-storage"
  },
  "Jwt": {
    "Key": "provide it bro",
    "Issuer": "SkillSense",
    "Audience": "SkillSense.Client",
    "AccessTokenExpiryMinutes": 30
  },
  "ResumeProcessingWorker": {
    "BatchSize": 5,
    "IdleTimeout": "00:02:00",
    "InitialBackoff": "00:00:01",
    "MaxBackoff": "00:00:30"
  },
  "AtsScoring": {
    "WorkExperienceWeight": 0.20,
    "SkillsWeight": 0.45,
    "ResponsibilitiesWeight": 0.10,
    "SummaryWeight": 0.10,
    "EducationWeight": 0.10,
    "YearsExperienceWeight": 0.05,
    "RequiredSkillsBlend": 0.75,
    "PreferredSkillsBlend": 0.25,
    "WorkScoreResponsibilityBlend": 0.25,
    "WorkScoreSummaryBlend": 0.5,
    "WorkScoreRequiredSkillsBlend": 0.25,
    "SemanticSkillThreshold": 0.64,
    "SemanticEvidenceTopK": 2,
    "SemanticEvidenceDecay": 0.75,
    "SemanticEvidenceStrongThreshold": 0.78,
    "SemanticEvidenceCoverageBonusMax": 0.04,
    "RequiredSkillMissingFloor": 0.35,
    "MissingResponsibilitiesNeutralScore": 0.62,
    "MissingSummaryNeutralScore": 0.62,
    "StrongMatchThreshold": 0.65,
    "StrongExperienceBoost": 0.11,
    "StrongSummaryBoost": 0.09,
    "CombinedStrongMatchBoost": 0.05,
    "MaxBoost": 0.2,
    "EducationGapPenalty": 0.02,
    "ExperienceGapPenaltyScale": 0.04,
    "MaxPenalty": 0.06
  }

}
